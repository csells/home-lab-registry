[Unit]
PartOf=lab-platform.target
Description=Home lab service registry
After=network-online.target
Wants=network-online.target
[Service]
Type=exec
User=lab-registry
Group=lab-registry
ExecStart=/opt/lab-platform-releases/current/bin/lab-registry --config /etc/lab-registry/config.json
Restart=on-failure
RestartSec=3
StateDirectory=lab-registry
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/lab-registry
MemoryMax=256M
TasksMax=64
