<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.home-lab.metrics</string>
	<key>ProcessType</key>
	<string>Background</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Library/Application Support/HomeLabMetrics/lab-metrics</string>
		<string>-config</string>
		<string>/Library/Application Support/HomeLabMetrics/config.json</string>
		<string>-socket</string>
		<string>/Library/Application Support/HomeLabMetrics/run/agent.sock</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/Library/Application Support/HomeLabMetrics/run/metrics.log</string>
	<key>StandardOutPath</key>
	<string>/Library/Application Support/HomeLabMetrics/run/metrics.log</string>
	<key>ThrottleInterval</key>
	<integer>30</integer>
	<key>UserName</key>
	<string>@SERVICE_USER@</string>
</dict>
</plist>
