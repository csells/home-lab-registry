[Unit]
PartOf=lab-platform.target
Description=Home lab machines and services dashboard
After=network-online.target
Wants=network-online.target
[Service]
Type=exec
User=lab-dashboard
WorkingDirectory=/opt/lab-platform-releases/current/dashboard
ExecStart=/opt/lab-platform-releases/current/bin/lab-dashboard /opt/lab-platform-releases/current/dashboard 8089
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
