[Unit]
Description=Home lab machines and services dashboard
After=network-online.target
Wants=network-online.target
[Service]
User=lab-dashboard
WorkingDirectory=/opt/machine-dashboard
ExecStart=/opt/machine-dashboard/bin/lab-dashboard /opt/machine-dashboard 8089
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
[Install]
WantedBy=multi-user.target
