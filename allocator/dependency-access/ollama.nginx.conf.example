# Include inside nginx's http block. Replace the example listener, certificate
# paths, allocator origin and model address with the private staging enrollment.
map $http_x_lab_lease_id $model_lease_id {
    default invalid;
    "~^[a-f0-9]{32}$" $http_x_lab_lease_id;
}

server {
    listen 192.0.2.10:8443 ssl;
    ssl_certificate /etc/home-lab/dependency-tls/cert.pem;
    ssl_certificate_key /etc/home-lab/dependency-tls/key.pem;
    access_log off;
    client_max_body_size 512k;

    location = /check-model-lease {
        internal;
        proxy_pass https://192.0.2.20:8443/v1/leases/$model_lease_id/dependencies/models;
        proxy_method GET;
        proxy_pass_request_body off;
        proxy_pass_request_headers off;
        proxy_set_header Content-Length "";
        proxy_set_header Authorization $http_authorization;
        proxy_ssl_verify on;
        proxy_ssl_server_name on;
        proxy_ssl_name allocator.example.invalid;
        proxy_ssl_trusted_certificate /etc/home-lab/dependency-tls/allocator-ca.pem;
        proxy_connect_timeout 3s;
        proxy_read_timeout 10s;
    }

    location ~ ^/api/(chat|generate)$ {
        limit_except POST { deny all; }
        auth_request /check-model-lease;

        proxy_pass http://192.0.2.30:11434;
        proxy_http_version 1.1;
        proxy_pass_request_headers off;
        proxy_set_header Content-Type application/json;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_connect_timeout 3s;
        proxy_read_timeout 120s;
    }

    location / { return 404; }
}
