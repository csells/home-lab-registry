# Include inside nginx's http block. Point the sole upstream at the
# enrolled NativeLink instance with scoped workers and cache storage.
# Use a separate listener and do not reuse this route for anonymous builds.
map $http_x_lab_lease_id $build_lease_id {
    default invalid;
    "~^[a-f0-9]{32}$" $http_x_lab_lease_id;
}

server {
    listen 192.0.2.10:8443 ssl;
    http2 on;
    ssl_certificate /etc/home-lab/dependency-tls/cert.pem;
    ssl_certificate_key /etc/home-lab/dependency-tls/key.pem;
    access_log off;
    client_max_body_size 8m;

    location = /check-build-lease {
        internal;
        proxy_pass https://192.0.2.20:8443/v1/leases/$build_lease_id/dependencies/build;
        proxy_method GET;
        proxy_pass_request_body off;
        proxy_pass_request_headers off;
        proxy_set_header Content-Length "";
        proxy_set_header Authorization $http_authorization;
        proxy_ssl_verify on;
        proxy_ssl_server_name on;
        proxy_ssl_name allocator.example.invalid;
        proxy_ssl_trusted_certificate /etc/home-lab/dependency-tls/allocator-ca.pem;
        proxy_connect_timeout 3s;
        proxy_read_timeout 10s;
    }

    location ~ ^/build[.]bazel[.]remote[.]execution[.]v2[.](Capabilities/GetCapabilities|Execution/(Execute|WaitExecution)|ContentAddressableStorage/(BatchUpdateBlobs|BatchReadBlobs|FindMissingBlobs|GetTree)|ActionCache/(GetActionResult|UpdateActionResult))$ {
        include /etc/home-lab/bazel-request.conf;
    }

    location ~ ^/google[.]bytestream[.]ByteStream/(Read|Write|QueryWriteStatus)$ {
        include /etc/home-lab/bazel-request.conf;
    }

    location / { return 404; }
}
