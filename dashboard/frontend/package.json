{
  "name": "home-lab-dashboard",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "esbuild main.tsx --bundle --minify --legal-comments=inline --outfile=../dashboard-react.js && cp node_modules/elkjs/lib/elk-worker.min.js ../vendor/",
    "test:browser": "node --test --test-concurrency=1 tests/browser/*.test.ts"
  },
  "dependencies": {
    "elkjs": "0.12.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
